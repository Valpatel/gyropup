{
  "name": "gyropup-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build-site.mjs",
    "dev": "npm run build && node tools/serve-site.mjs",
    "preview": "node tools/serve-site.mjs",
    "preview:status": "node tools/serve-site.mjs --status",
    "test:preview": "node --test tools/test-site-preview.mjs",
    "deploy": "npm run build && wrangler --cwd .github pages deploy ../dist --project-name gyropup --branch main",
    "test:web": "node tools/test-site.mjs",
    "test:markdown": "node --test tools/test-markdown.mjs",
    "test:cache": "node --test tools/test-site-ranges.mjs && node tools/test-cache.mjs",
    "test:sim": "node tools/test-sim-transitions.mjs",
    "test:turret": "python3 tools/test-turret-frames.py && node tools/test-turret-motion.mjs",
    "test:services": "node tools/test-service-discovery.mjs",
    "test:camera": "node tools/test-camera-controls.mjs",
    "test:interactions": "node tools/test-turret-interactions.mjs",
    "test:robot": "node tools/test-robot-controls.mjs",
    "test:gamepad": "node --test designer/kit/gamepad/gamepad.test.mjs && node tools/test-gamepad.mjs",
    "test:viewers": "node tools/test-portal-viewers.mjs",
    "test:file-viewer-theme": "node tools/test-file-viewer-theme.mjs",
    "test:audio": "node tools/test-audio-settings.mjs",
    "test:voice": "python3 tools/test-pronunciation.py && node --test tools/test-pronunciation.mjs && python3 tools/render-voice.py --check",
    "test:hero": "node tools/test-hero-preview.mjs",
    "test:demo": "node tools/test-live-demo.mjs",
    "test:rs04": "node --test designer/kit/rs04/rs04.test.mjs && python3 -m unittest rig.tests.test_rs04_vectors rig.tests.test_rs04_bridge",
    "test:motor-tool": "node tools/test-motor-tool.mjs",
    "test:models": "node tools/test-current-model.mjs",
    "test:legs": "python3 tools/test-leg-attachments.py && node tools/test-leg-attachment-motion.mjs",
    "test:notice": "node tools/test-prototype-notice.mjs",
    "test:portal-data": "node --test tools/test-portal-data.mjs",
    "test:leg-limits": "node --test tools/test-leg-limits.mjs",
    "test:loading-sim": "node tools/test-loading-sim.mjs",
    "test:loading-portal": "node tools/test-loading-portal.mjs",
    "test:loading-hero": "node tools/test-loading-hero.mjs",
    "test:part-media": "node --test tools/test-part-media.mjs",
    "test:build-portal": "node --test tools/test-model-links.mjs tools/test-print-now.mjs && node tools/test-build-portal.mjs",
    "test:study-media": "python3 tools/test-study-media.py && node tools/test-study-media.mjs",
    "test:diagrams": "node tools/test-diagrams.mjs",
    "test:carrier-inspection": "node --test tools/test-hosted-navigation.mjs && node tools/test-carrier-inspection.mjs && CARRIER_INSPECTION_CASE=c3-support node tools/test-carrier-inspection.mjs",
    "test:progress": "node tools/test-progress.mjs",
    "test:highlights": "node tools/test-highlight-video.mjs",
    "test:highlight-integration": "node tools/test-highlight-integration.mjs",
    "test:highlight-media": "python3 tools/check-highlights.py",
    "test:landing-loop": "node --test tools/test-landing-loop.mjs",
    "test:privacy": "node --test tools/test-privacy.mjs",
    "test:status-board": "node --test tools/test-status-board.mjs",
    "test:timeline": "node --test tools/test-timeline.mjs",
    "test:doc-pages": "node --test tools/test-doc-pages.mjs",
    "test:walls": "node tools/test-walls.mjs",
    "test:empty-space": "node tools/test-empty-space.mjs",
    "test:theme": "node --test tools/test-theme.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "linkedom": "0.18.14",
    "marked": "16.4.1",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "wrangler": "4.154.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
