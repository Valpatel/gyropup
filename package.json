{
  "name": "gyropup-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/site/build-site.mjs",
    "dev": "npm run build && node tools/site/serve-site.mjs",
    "preview": "node tools/site/serve-site.mjs",
    "preview:status": "node tools/site/serve-site.mjs --status",
    "test:preview": "node --test tests/site/platform/test-site-preview.mjs",
    "deploy": "npm run build && wrangler --cwd .github pages deploy ../dist --project-name gyropup --branch main",
    "test:web": "node tests/site/platform/test-site.mjs",
    "test:markdown": "node --test tests/site/content/test-markdown.mjs",
    "test:cache": "node --test tests/site/platform/test-site-ranges.mjs && node tests/site/platform/test-cache.mjs",
    "test:sim": "node tests/site/controls/test-sim-transitions.mjs",
    "test:turret": "python3 tests/evidence/test-turret-frames.py && node tests/site/models/test-turret-motion.mjs",
    "test:services": "node tests/site/platform/test-service-discovery.mjs",
    "test:camera": "node tests/site/controls/test-camera-controls.mjs",
    "test:interactions": "node --test tests/site/controls/test-turret-stops.mjs && node tests/site/controls/test-turret-interactions.mjs",
    "test:robot": "node tests/site/controls/test-robot-controls.mjs",
    "test:gamepad": "node --test software/site/designer/kit/gamepad/gamepad.test.mjs tests/site/controls/test-hop-budget.mjs && node tests/site/controls/test-gamepad.mjs",
    "test:viewers": "node tests/site/loading/test-portal-viewers.mjs",
    "test:file-viewer-theme": "node tests/site/platform/test-file-viewer-theme.mjs",
    "test:audio": "node tests/site/controls/test-audio-settings.mjs",
    "test:voice": "python3 tests/software/audio/test-pronunciation.py && node --test tests/site/content/test-pronunciation.mjs && python3 tools/audio/render-voice.py --check",
    "test:hero": "node --test tests/evidence/media/test-hero-poster-output.mjs && node tests/site/media/test-hero-preview.mjs",
    "test:demo": "node tests/site/controls/test-live-demo.mjs",
    "test:rs04": "node --test software/site/designer/kit/rs04/rs04.test.mjs && python3 -m unittest tests.control.rig.test_rs04_vectors tests.control.rig.test_rs04_bridge",
    "test:motor-tool": "node tests/site/controls/test-motor-tool.mjs",
    "test:models": "node tests/site/models/test-current-model.mjs",
    "test:legs": "python3 tests/hardware/interfaces/test-leg-attachments.py && node tests/site/models/test-leg-attachment-motion.mjs",
    "test:notice": "node tests/site/content/test-prototype-notice.mjs",
    "test:portal-data": "node --test tests/site/loading/test-portal-data.mjs",
    "test:leg-limits": "node --test tests/site/controls/test-leg-limits.mjs",
    "test:loading-sim": "node tests/site/loading/test-loading-sim.mjs",
    "test:loading-portal": "node tests/site/loading/test-loading-portal.mjs",
    "test:loading-hero": "node tests/site/loading/test-loading-hero.mjs",
    "test:part-media": "node --test tests/site/media/test-part-media.mjs",
    "test:build-portal": "node --test tests/site/platform/test-model-links.mjs tests/site/content/test-print-now.mjs && node tests/site/content/test-build-portal.mjs",
    "test:study-media": "python3 tests/evidence/test-study-media.py && node tests/site/media/test-study-media.mjs",
    "test:diagrams": "node tests/site/layout/test-diagrams.mjs",
    "test:carrier-inspection": "node --test tests/site/platform/test-hosted-navigation.mjs && node tests/site/models/test-carrier-inspection.mjs && CARRIER_INSPECTION_CASE=c3-support node tests/site/models/test-carrier-inspection.mjs",
    "test:progress": "node tests/site/content/test-progress.mjs",
    "test:highlights": "node tests/site/media/test-highlight-video.mjs",
    "test:highlight-integration": "node tests/site/media/test-highlight-integration.mjs",
    "test:highlight-media": "python3 tests/evidence/media/test-highlight-bindings.py && python3 tools/evidence/media/check-highlights.py",
    "test:landing-loop": "node --test tests/site/media/test-landing-loop.mjs",
    "test:privacy": "node --test tests/site/content/test-privacy.mjs",
    "test:status-board": "node --test tests/site/content/test-status-board.mjs",
    "test:timeline": "node --test tests/site/content/test-timeline.mjs",
    "test:doc-pages": "node --test tests/site/layout/test-doc-pages.mjs",
    "test:walls": "node tests/site/layout/test-walls.mjs",
    "test:empty-space": "node tests/site/layout/test-empty-space.mjs",
    "test:theme": "node --test tests/site/platform/test-theme.mjs",
    "test:build-guide": "python3 -B tools/site/assembly/export_turret_guide.py --check && python3 -B tests/site/assembly/test_turret_guide.py && python3 -B -m unittest discover -s tests/site/assembly -p 'test_robot*.py' && node --test tests/site/assembly/test-build-session-unit.mjs tests/site/assembly/test-guide-state.mjs tests/site/assembly/test-guide-fallback.mjs tests/site/assembly/test-poster-contract.mjs tests/site/assembly/test-print-selection.mjs tests/site/assembly/test-print-mount.mjs && node tools/site/assembly/poster-contract.mjs --check && node tests/site/assembly/test-build-guide.mjs && npm run test:build-loading",
    "test:instruction-docking": "node --test tests/site/assembly/test-capture-diagnostics.mjs && node tests/site/assembly/test-instruction-docking.mjs",
    "test:build-workspace": "node tests/site/assembly/test-build-workspace.mjs",
    "test:build-route": "node tests/site/assembly/test-build-route.mjs",
    "test:build-loading": "node tests/site/assembly/test-build-loading.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "linkedom": "0.18.14",
    "marked": "16.4.1",
    "sharp": "0.35.5",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "wrangler": "4.154.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
