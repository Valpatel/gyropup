.venv/
__pycache__/
*.pyc
node_modules
hardware/exports/*.log
runs/
!hardware/exports/rig/runs/
/site/
preview/site-url.txt
build/
hardware/exports/sim/
hardware/exports/mjcf/
hardware/exports/links/local/

# vendor CAD has no licence to redistribute: keep it local, track only where it came from
hardware/vendor/**
!hardware/vendor/**/
!hardware/vendor/**/SOURCE.txt

# optimiser trials (tools/iterate.py)
work/
hardware/exports/iterate/
hardware/exports/turret/*.step
hardware/exports/turret/*.stl

# meshes the rig simulation writes for its videos
hardware/exports/leg/rig_meshes/

# the spring study's every-step results (48 MB): rebuilt by sim/leg_spring_study.py
hardware/exports/leg/springs/results*.json

# the body's assembly STEP (12 MB, rebuilt by cad/build_body.py) and the FEA viewer files (3 MB each)
hardware/exports/body/body_stand.step
hardware/exports/body/fea/*.json
!hardware/exports/body/fea/summary.json

# B10: the J501 project's parameters, vendored on purpose (our own project; cad/body_params.py --snapshot-j501)
!hardware/vendor/j501/SOURCE.json
!hardware/vendor/j501/parameters-0.9-g48r.json
# the whole rig as one STEP (5.8 MB): rebuilt by cad/build_rig.py
hardware/exports/rig/rig_300.step

# The local preview and Cloudflare Pages use the same generated bundle.
dist/
.wrangler/
test-results/
# Public browser simulation snapshot; no RL policies or private run directories.
!hardware/exports/sim/
!hardware/exports/sim/**
/.cadagent-cache/
# Read-only pinned shared README tooling, checked out by the cheap CI job.
/.readme-profile/
/.readme-svg/

# Independent pinned shared motion validator checkout used only by CI.
/.cad-agent-motion/
