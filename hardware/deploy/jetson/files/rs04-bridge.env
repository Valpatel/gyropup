# Gyropup RS-04 bridge settings (hardware/deploy/jetson). install.sh writes this file once and never overwrites it.
# IFACE: the SocketCAN interface of the USB adapter on the leg's bus. 'rs04' is the stable name to give the PCAN-USB
#   in can-names.conf. Not can0: on the J501 that is the module's own CAN port, bus C (the MCU and the VESCs).
# PROFILE: the build profile whose limits the bridge enforces (hardware/actuators/rs04/profiles/).
IFACE=rs04
PROFILE=pla-bench
PORT=8765
