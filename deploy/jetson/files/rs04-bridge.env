# Gyropup RS-04 bridge settings (deploy/jetson). install.sh writes this file once and never overwrites it.
# IFACE: the SocketCAN interface the leg motors are on (a stable name from can-names.conf, or can0..).
# PROFILE: the build profile whose limits the bridge enforces (hardware/actuators/rs04/profiles/).
IFACE=can0
PROFILE=pla-bench
PORT=8765
