# Gyropup: bring a CAN interface up at the robot's bit rate when it appears (deploy/jetson, installed by install.sh).
# Started by the udev rule 80-gyropup-can.rules for every SocketCAN interface of a USB adapter (peak_usb, gs_usb).
[Unit]
Description=Gyropup CAN interface %i at the configured bit rate
BindsTo=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=BITRATE=1000000 RESTART_MS=100 TXQUEUELEN=1000
EnvironmentFile=-/etc/gyropup/can.env
ExecStart=/bin/sh -c 'ip link set "$1" down; ip link set "$1" type can bitrate "$BITRATE" restart-ms "$RESTART_MS" && ip link set "$1" txqueuelen "$TXQUEUELEN" && ip link set "$1" up' sh %i
ExecStop=/bin/sh -c 'ip link set "$1" down' sh %i

[Install]
WantedBy=multi-user.target
