# Stable names for the robot's USB CAN adapters (deploy/jetson). Copy to /etc/gyropup/can-names.conf, fill in from
# `sudo deploy/jetson/install.sh --list-can`, and run install.sh again.
#
# One adapter a line: NAME  path=<ID_PATH>  or  NAME  serial=<ID_SERIAL_SHORT>
#   NAME: at most 15 characters, letters, digits and '_' (no '-'); not "can" + a digit (kernel names)
#   The bridge's default interface is rs04 (/etc/gyropup/rs04-bridge.env): give the PCAN-USB that name.
#   path=: the USB port the adapter is plugged into (stays the same while it stays in that port)
#   serial=: the adapter's own serial number, when it reports one
#
# rs04        path=platform-3610000.usb-usb-0:1.2:1.0
# can_legs_a  path=platform-3610000.usb-usb-0:1.2:2.0
# can_legs_b  serial=0000ABCD
