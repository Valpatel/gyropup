 "model": ".venv/bin/python sim/turret_flight.py [--quick]    # writes exports/turret/flight/flight.json and plots",
 "flight": {
  "rho": 1.205,
  "nu_air": 1.506e-05,
  "air_source": "air at 20 C, 1 atm: 1.205 kg/m^3 (https://www.engineeringtoolbox.com/air-properties-d_156.html), 15.06 cSt (https://www.engineeringtoolbox.com/air-absolute-kinematic-viscosity-d_601.html); checked 2026-10-27",
  "cd": 0.47,
  "cd_range": [
   0.4,
   0.55
  ],
  "cd_source": "sphere in the Newton regime: Cd 0.38 (Re 5e3) to 0.50 (Re 7e4), Clift-Gauvin fit within 6 % (https://arxiv.org/pdf/1810.08787, Morrison 2016 https://pages.mtu.edu/~fmorriso/DataCorrelationForSphereDrag2016.pdf); a polystyrene foam ball fits Cd 0.4-0.5 (https://arxiv.org/pdf/1005.4086); rough/napped spheres run 0.55-0.8 (https://ojs.ub.uni-konstanz.de/cpa/article/view/1221/1108); the RoboMaster wheel guide uses 0.50 for its 17 mm TPU ball. Here Re = 1.5e4-3.3e4: 0.47 nominal (Clift-Gauvin gives 0.44-0.47), swept to 0.55 for a fuzzy foam surface; checked 2026-10-27",
  "cl": "Nathan 2008 fit of Sawicki et al. (https://arxiv.org/pdf/physics/0605041): C_L = 1.5 S (S < 0.1), 0.09 + 0.6 S (S >= 0.1), S = r w / v; subcritical LES at Re 1e4 gives C_L ~ 0.17 at S = 0.1 (Muto et al., https://eprints.lib.hokudai.ac.jp/repo/huscap/all/53053/JoV15-3_261-268.pdf); the negative Magnus regime sits near the critical Re (4.6e4-2e5 for smooth spheres), above this ball's; checked 2026-10-27",
  "muzzle_height_m": 0.55,
  "muzzle_height_note": "est: the standing robot's TM face ~0.33 m hip + 0.214 m (exports/turret/turret.json mount z); the game targets sit at 0.30 m",
  "validation_sources": {
   "nuaa_wheel_guide": "NUAA friction-wheel design guide (RoboMaster forum, 2024.9, https://bbs-web-static.robomaster.com/bbs-prod/b98a53d00cb548a2a3d8346e48439cf0/%E6%91%A9%E6%93%A6%E8%BD%AE%E8%AE%BE%E8%AE%A1%E6%8C%87%E5%8D%97.pdf): a deliberate 1000 rpm wheel mismatch moved the 17 mm ball only ~13 cm at 15 m; 0.1 m/s of speed noise moves the fall point > 10 cm; contact < 5 ms at 340 g; checked 2026-10-27",
   "nathan_two_wheel": "Nathan (https://arxiv.org/pdf/physics/0605041): two-wheel pitching machine: ball speed = the mean of the two surface speeds, spin from their difference",
   "blasterhub": "BlasterHub: Hasbro Rival rounds 97 fps average over 100 shots, none under 92 or over 101 (https://blasterhub.com/2017/12/adventure-force-tactical-strike-rounds-review/)"
  }
 },
